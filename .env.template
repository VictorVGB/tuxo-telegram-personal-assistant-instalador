# Tuxo — template de variáveis de ambiente
# Copie para .env.local e preencha os valores

# ====================
# TELEGRAM
# Criar bot: fale com @BotFather no Telegram → /newbot
# Seu chat_id: fale com @userinfobot no Telegram
# ====================
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
OWNER_TELEGRAM_CHAT_ID=987654321
# Opcional: string aleatória para autenticar updates do Telegram no webhook
TELEGRAM_WEBHOOK_SECRET=

# ====================
# CLAUDE / ANTHROPIC
# API key gerada em console.anthropic.com/settings/keys (cobrada por crédito)
# ====================
ANTHROPIC_API_KEY=sk-ant-api03-...

# ====================
# GITHUB (vault Obsidian)
# Crie um repositório privado para o seu vault e aponte aqui
# Token: gh auth token (escopo repo)
# ====================
VAULT_REPO_URL=https://github.com/SEU_USUARIO/SEU_VAULT.git
GITHUB_TOKEN=gho_...

# ====================
# AWS (necessário para infra Terraform e produção)
# Criar IAM user tuxo-terraform com política scripts/aws_terraform_policy.json
# ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxxxx...
